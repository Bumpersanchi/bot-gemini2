# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Meta for Developers > tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que tú inventas y pones también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > tu app > Configuración > Básica > Clave secreta de la app
WHATSAPP_APP_SECRET=

# Opcionales
# BOT_MODEL=claude-opus-5-5
# BOT_EFFORT=low
# SYSTEM_PROMPT=Eres el asistente de mi tienda...
# PORT=8000
